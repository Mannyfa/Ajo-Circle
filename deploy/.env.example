# Copy to deploy/.env (git-ignored) and fill in. Never commit the real file.

# Database password: long and random, e.g. `openssl rand -base64 32`.
POSTGRES_PASSWORD=

# The public address people type, with no trailing slash. Used in email links.
PUBLIC_BASE_URL=https://app.example.com

# Port on this machine that the web container listens on (not needed if you only use the Cloudflare Tunnel).
WEB_PORT=8080

# Email (sign-up and password-reset codes). Any SMTP provider. Until this is set, the app refuses to send codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# Which header holds the visitor's real address.
#   Behind Cloudflare (proxied DNS or a Tunnel): CF-Connecting-IP
#   Directly on the internet, or behind another proxy that sets it: X-Forwarded-For
CLIENT_IP_HEADER=X-Forwarded-For

# Optional, recommended: encrypt the stored key ring with a certificate kept outside the database.
# Put the .pfx in deploy/secrets/ and refer to it by its path inside the container.
DATA_PROTECTION_CERT_PATH=
# DATA_PROTECTION_CERT_PATH=/run/secrets/ajocircle/dataprotection.pfx
DATA_PROTECTION_CERT_PASSWORD=

# Nightly database dumps.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# Only with `--profile tunnel`: the token from Cloudflare Zero Trust > Networks > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

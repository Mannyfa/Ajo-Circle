{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": { "MigrateOnStartup": false },
  "RateLimits": { "AuthPerMinute": 10, "InvitationsPerMinute": 30 }
}
